# ==========================================================
# avu-api — variáveis de ambiente
# Copie para .env e preencha. NUNCA comite .env real.
# ==========================================================

# ---------- App ----------
APP_ENV=dev                    # dev | prod
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ---------- JWT ----------
# HS512, compatível com tokens do legado Java (FiltroAutenticacao)
JWT_SECRET=oSenhorEhMeuPastor
JWT_ALG=HS512
JWT_EXPIRE_MINUTES=480

# ---------- DB2 ----------
DB2_HOST=producao.uem.br
DB2_PORT=50000
DB2_DATABASE=producao
DB2_USER=sgv
DB2_PASSWORD=
DB2_POOL_SIZE=10

# ---------- Banco do Brasil — UEM ----------
BB_UEM_OAUTH_URL=https://oauth.bb.com.br/oauth/token
BB_UEM_COB_URL=https://api-pix.bb.com.br/pix/v2/cob
BB_UEM_CLIENT_ID=
BB_UEM_CLIENT_SECRET=
BB_UEM_GW_APP_KEY=
BB_UEM_P12_PATH=/secrets/certificadoA1_UEM_novo.p12
BB_UEM_P12_PASSWORD=
BB_UEM_CER_PATH=/secrets/intermediario_uem_novo.cer

# ---------- HTTP timeouts (BB) ----------
BB_CONNECT_TIMEOUT_SEC=30
BB_READ_TIMEOUT_SEC=60

# ---------- Polling / scheduler ----------
PIX_POLL_INTERVAL_SEC=5
PIX_EXPIRATION_MINUTES=5
